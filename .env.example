# ==============================================================================
# Campus Reunion Poll — Environment Configuration Template
# ==============================================================================

# 1. Supabase Cloud Configuration
# Retrieve these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Server Session Signing Secret (Must be at least 32 characters long)
SESSION_SECRET=campus-reunion-poll-super-secure-jwt-signing-secret-key-32chars

# 3. Optional Authentication & SMS Settings
# Set to "true" to activate Supabase Phone Auth OTP via Twilio / MessageBird
NEXT_PUBLIC_ENABLE_SMS_OTP=false

# 4. Initial Class Representative Mobile Number (Designates initial admin)
INITIAL_ADMIN_MOBILE=9876543210

# 5. App URL for invitations and metadata
NEXT_PUBLIC_APP_URL=https://campus-reunion-poll.vercel.app

